#. module: portal
#: model_terms:ir.ui.view,arch_db:portal.address_form_fields
msgid ""
"<small class=\"form-text text-muted\">\n"
"                            Changing VAT number is not allowed once document(s) have\n"
"                            been issued for your account. Please contact us directly for this\n"
"                            operation.\n"
"                        </small>"
msgstr ""
"<small class=\"form-text text-muted\">\n"
"                            Змінювати ІПН платника ПДВ заборонено після того, як для вашого облікового запису\n"
"                            було видано документи. Для цієї операції зверніться\n"
"                            до нас безпосередньо.\n"
"                        </small>"

#. module: portal
#: model_terms:ir.ui.view,arch_db:portal.address_form_fields
msgid ""
"<small class=\"form-text text-muted\">\n"
"                            The VAT number can only be updated on the company account.\n"
"                        </small>"
msgstr ""
"<small class=\"form-text text-muted\">\n"
"                            ІПН платника ПДВ можна оновити лише в обліковому записі компанії.\n"
"                        </small>"

#. module: portal
#: model_terms:ir.ui.view,arch_db:portal.address_form_fields
msgid ""
"<small class=\"form-text text-muted\">\n"
"                    Changing country is not allowed once document(s) have\n"
"                    been issued for your account. Please contact us directly for this\n"
"                    operation.\n"
"                </small>"
msgstr ""
"<small class=\"form-text text-muted\">\n"
"                    Змінювати країну заборонено після того, як для вашого облікового запису\n"
"                    було видано документи. Для цієї операції зверніться\n"
"                    до нас безпосередньо.\n"
"                </small>"

