<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Generated by tools/build_schemes.py. Colour schemes: one pair of assets per scheme
         (Odoo variables + CSS tokens), exactly one pair active, switched by Settings > Theme.
         Paths start with "/" so they resolve both for a module installed from the file
         system and for one imported as a zip (served from attachments).
         noupdate: the chosen scheme survives module updates. -->
    <data noupdate="1">
        <record id="scheme_classic_variables" model="ir.asset">
            <field name="name">Colour scheme BAS Classic: variables</field>
            <field name="bundle">web._assets_primary_variables</field>
            <field name="directive">before</field>
            <field name="target">web/static/src/scss/primary_variables.scss</field>
            <field name="path">/backend_theme_bas/static/src/schemes/classic_variables.scss</field>
            <field name="active" eval="False"/>
        </record>
        <record id="scheme_classic_tokens" model="ir.asset">
            <field name="name">Colour scheme BAS Classic: tokens</field>
            <field name="bundle">web.assets_backend</field>
            <field name="path">/backend_theme_bas/static/src/schemes/classic.scss</field>
            <field name="active" eval="False"/>
        </record>
