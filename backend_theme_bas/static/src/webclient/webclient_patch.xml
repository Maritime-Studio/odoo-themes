<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Sections panel between the top bar and the action area (desktop only). -->
    <t t-inherit="web.WebClient" t-inherit-mode="extension">
        <xpath expr="//ActionContainer" position="before">
            <BasSidebar t-if="!state.fullscreen and !env.isSmall"/>
        </xpath>
    </t>

    <!-- Hamburger at the far left of the top bar, like BAS. -->
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav[hasclass('o_main_navbar')]" position="inside">
            <button t-if="!this.ui.isSmall" type="button" class="o_bas_toggle order-first"
                    title="Sections panel" aria-label="Sections panel"
                    t-on-click="onBasToggleSidebar">
                <i class="fa fa-bars" aria-hidden="true"/>
            </button>
        </xpath>
    </t>

    <!-- Chat position toggle, left of the systray (desktop only). -->
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_menu_systray')]" position="before">
            <button t-if="!this.ui.isSmall" type="button" class="o_bas_chatter_toggle ms-auto"
                    t-att-class="{ 'o_bas_active': basLayout.chatterBelow }"
                    t-att-title="basLayout.chatterBelow ? 'Chat: below the form (click to show it on the side)' : 'Chat: on the side when there is room (click to show it below the form)'"
                    t-on-click="onBasToggleChatter">
                <i class="fa fa-comments-o" aria-hidden="true"/>
                <i t-attf-class="fa fa-fw small {{ basLayout.chatterBelow ? 'fa-arrow-down' : 'fa-arrow-right' }}" aria-hidden="true"/>
            </button>
        </xpath>
    </t>

</templates>
