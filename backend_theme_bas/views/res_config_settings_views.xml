<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Theme" entry in the left list of Settings, next to CRM, Sales... -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.backend_theme_bas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Theme" string="Theme" name="backend_theme_bas" groups="base.group_system">
                    <block title="Colour scheme" name="bas_theme_colour_scheme">
                        <setting string="Colour scheme" help="Look of the interface for every user of this database: BAS Classic, BAS Steel, Maritime.Studio or one of the pastel schemes.">
                            <div class="mt8">
                                <button name="%(backend_theme_bas.action_theme_settings)d" type="action"
                                        string="Choose colour scheme" class="btn-link" icon="oi-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
